REM Spectrum conformance: float text (PRINT / STR$), Spectrum style.
REM
REM The expected strings are the output of the Spectrum 48K ROM (PRINT-FP,
REM via STR$) for the same values: this file is the same table run on the ROM. Up to 8 significant digits, rounded; fixed notation
REM for decimal exponents -4..8 ("0.5", ".03", ".00001", "12345678"), else
REM exponent notation ("1E+8", "1.2345679E+9", "1.5E-10"). Each value goes
REM through a FLOAT variable so the runtime converts it (STR$ of a constant
REM is folded by the compiler, in Python, at full precision).
REM
REM rtNN: VAL accepts the exponent notation STR$ produces (VAL of the text, from a
REM string variable so it runs at runtime, gives back the number STR$ printed; compared by text, so a last-digit
REM wobble of the repeated 10x/10/ scaling would show up as a FAIL).

#include <zxtest.bas>

DIM f AS FLOAT
DIM s AS STRING

f = 0
CHK("fmt00", STR$(f), "0")
f = 1
CHK("fmt01", STR$(f), "1")
f = -1
CHK("fmt02", STR$(f), "-1")
f = 0.5
CHK("fmt03", STR$(f), "0.5")
f = -0.5
CHK("fmt04", STR$(f), "-0.5")
f = 1/3
CHK("fmt05", STR$(f), "0.33333333")
f = 2/3
CHK("fmt06", STR$(f), "0.66666667")
f = -1/3
CHK("fmt07", STR$(f), "-0.33333333")
f = 123456789
CHK("fmt08", STR$(f), "1.2345679E+8")
s = "1.2345679E+8"
CHK("rt08", STR$(VAL(s)), "1.2345679E+8")
f = 1234567890
CHK("fmt09", STR$(f), "1.2345679E+9")
s = "1.2345679E+9"
CHK("rt09", STR$(VAL(s)), "1.2345679E+9")
