{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "out",
    "rootDir": ".",
    "types": [
      "node",
      "vscode"
    ],
    "paths": {
      "@cpcbuild/cpcbas": [
        "./vendor/cpcbas/dist/src/index.d.ts"
      ],
      "@cpcbuild/cpcbas/node": [
        "./vendor/cpcbas/dist/src/node/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
