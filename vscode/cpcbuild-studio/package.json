{
  "name": "cpcbuild-studio",
  "displayName": "CPCBuild Studio",
  "description": "Amstrad CPC tools for CPCBuild (Boriel BASIC --arch cpc): palette, sprite and tile editors, image importer, build and run.",
  "version": "0.0.1",
  "publisher": "cpcbuild",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/cpcbuild.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the palette, sprite, tile and map editors, the image importer and the symbol views open, but nothing that starts a program runs: Build, Run, Regenerate Assets and generate-on-save, Convert and Play Music, Open in Tiled and the tool checks of Check Environment. Settings that name programs or paths (compiler, Python, library, emulators including the Spectrum one, Arkos, Tiled) and the \"library\" field of cpcbuild.json are ignored until the workspace is trusted.",
      "restrictedConfigurations": [
        "cpcbuild.zxbc.command",
        "cpcbuild.zxbc.cwd",
        "cpcbuild.zxbc.args",
        "cpcbuild.sdk.path",
        "cpcbuild.python.path",
        "cpcbuild.library.path",
        "cpcbuild.build.outputDir",
        "cpcbuild.run.caprice32Path",
        "cpcbuild.run.cpcecPath",
        "cpcbuild.run.rvmPath",
        "cpcbuild.run.customCommand",
        "cpcbuild.run.zxEmulator",
        "cpcbuild.run.zxEmulatorArgs",
        "cpcbuild.run.autorunCommand",
        "cpcbuild.assets.engine",
        "cpcbuild.arkos.toolsPath",
        "cpcbuild.arkos.trackerPath",
        "cpcbuild.tiled.path"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "cpcbuild.newProject",
        "title": "New Project",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.newSprite",
        "title": "New Sprite",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.newTileset",
        "title": "New Tileset",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.newPalette",
        "title": "New Palette",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.newPlusSprite",
        "title": "New Plus Sprite",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.importImage",
        "title": "Import Image",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.copyImporterCommand",
        "title": "Copy Importer Command",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.regenerateAssets",
        "title": "Regenerate Assets",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.generateAssetFile",
        "title": "Generate Asset File",
        "category": "CPCBuild",
        "icon": "$(run)"
      },
      {
        "command": "cpcbuild.insertAssetUse",
        "title": "Insert Asset Use",
        "category": "CPCBuild",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "cpcbuild.build",
        "title": "Build",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.buildAndRun",
        "title": "Build and Run",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.run",
        "title": "Run Last Build",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.selectTarget",
        "title": "Select Target",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.selectEmulator",
        "title": "Select Emulator",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.selectModel",
        "title": "Select Model",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.runFile",
        "title": "Run in Emulator",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.showBuildReport",
        "title": "Show Build Report",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.tmx.generate",
        "title": "Convert Tiled Map to BASIC",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.openInTiled",
        "title": "Open in Tiled",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.music.convert",
        "title": "Convert Music",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.music.play",
        "title": "Play Music",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.music.stop",
        "title": "Stop Music",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.music.openTracker",
        "title": "Open in Arkos Tracker",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.symbols.refresh",
        "title": "Refresh Symbols",
        "category": "CPCBuild",
        "icon": "$(refresh)"
      },
      {
        "command": "cpcbuild.memory.show",
        "title": "Show Memory",
        "category": "CPCBuild",
        "icon": "$(chip)"
      },
      {
        "command": "cpcbuild.debug.pause",
        "title": "Debug: Pause",
        "category": "CPCBuild",
        "icon": "$(debug-pause)"
      },
      {
        "command": "cpcbuild.debug.resume",
        "title": "Debug: Resume",
        "category": "CPCBuild",
        "icon": "$(debug-continue)"
      },
      {
        "command": "cpcbuild.debug.step",
        "title": "Debug: Step (One Instruction)",
        "category": "CPCBuild",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "cpcbuild.debug.toggleBreakpoint",
        "title": "Debug: Toggle Breakpoint",
        "category": "CPCBuild",
        "icon": "$(debug-breakpoint)"
      },
      {
        "command": "cpcbuild.lint.toggle",
        "title": "Toggle Lint",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.docs.open",
        "title": "Open Library Docs",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.downloadTools",
        "title": "Download Tools",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.checkEnvironment",
        "title": "Check Environment",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.openAsText",
        "title": "Reopen as Text",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.openSettings",
        "title": "Open Settings",
        "category": "CPCBuild"
      },
      {
        "command": "cpcbuild.symbols.filter",
        "title": "Filter Symbols",
        "category": "CPCBuild",
        "icon": "$(filter)"
      },
      {
        "command": "cpcbuild.symbols.toggleRuntime",
        "title": "Show or Hide Runtime Symbols",
        "category": "CPCBuild",
        "icon": "$(eye)"
      },
      {
        "command": "cpcbuild.symbols.copyAddress",
        "title": "Copy Symbol Address",
        "category": "CPCBuild",
        "icon": "$(copy)"
      },
      {
        "command": "cpcbuild.symbols.goToDefinition",
        "title": "Go to Symbol Definition",
        "category": "CPCBuild",
        "icon": "$(go-to-file)"
      },
      {
        "command": "cpcbuild.debug.stepOver",
        "title": "Debug: Step Over",
        "category": "CPCBuild",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "cpcbuild.debug.stepOut",
        "title": "Debug: Step Out",
        "category": "CPCBuild",
        "icon": "$(debug-step-out)"
      },
      {
        "command": "cpcbuild.debug.removeBreakpoint",
        "title": "Remove Breakpoint",
        "category": "CPCBuild",
        "icon": "$(close)"
      },
      {
        "command": "cpcbuild.debug.showRegisters",
        "title": "Debug: Show Registers",
        "category": "CPCBuild",
        "icon": "$(symbol-numeric)"
      }
    ],
    "customEditors": [
      {
        "viewType": "cpcbuild.paletteEditor",
        "displayName": "CPCBuild Palette Editor",
        "selector": [
          {
            "filenamePattern": "*.cpcpal"
          },
          {
            "filenamePattern": "*.cpcpal12"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "cpcbuild.spriteEditor",
        "displayName": "CPCBuild Sprite Editor",
        "selector": [
          {
            "filenamePattern": "*.cpcspr"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "cpcbuild.tileEditor",
        "displayName": "CPCBuild Tile Editor",
        "selector": [
          {
            "filenamePattern": "*.cpctil"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "cpcbuild.importer",
        "displayName": "CPCBuild Image Importer",
        "selector": [
          {
            "filenamePattern": "*.cpcimp"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "cpcbuild.tmxViewer",
        "displayName": "CPCBuild Map Viewer",
        "selector": [
          {
            "filenamePattern": "*.tmx"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cpcbuild.runFile",
          "when": "cpcbuild.inProject && resourceExtname =~ /^\\.(dsk|bin)$/",
          "group": "navigation@90"
        },
        {
          "command": "cpcbuild.importImage",
          "when": "cpcbuild.inProject && resourceExtname =~ /^\\.(png|gif|bmp)$/",
          "group": "navigation@90"
        },
        {
          "command": "cpcbuild.tmx.generate",
          "when": "cpcbuild.inProject && resourceExtname == .tmx",
          "group": "navigation@91"
        },
        {
          "command": "cpcbuild.openInTiled",
          "when": "cpcbuild.inProject && resourceExtname == .tmx",
          "group": "navigation@92"
        },
        {
          "command": "cpcbuild.music.convert",
          "when": "cpcbuild.inProject && resourceExtname =~ /^\\.(aks|vt2)$/",
          "group": "navigation@91"
        },
        {
          "command": "cpcbuild.music.play",
          "when": "cpcbuild.inProject && resourceExtname =~ /^\\.(aks|vt2)$/",
          "group": "navigation@92"
        }
      ],
      "editor/title": [
        {
          "command": "cpcbuild.openAsText",
          "when": "cpcbuild.inProject && activeCustomEditorId == cpcbuild.paletteEditor",
          "group": "navigation@90"
        },
        {
          "command": "cpcbuild.openAsText",
          "when": "cpcbuild.inProject && activeCustomEditorId == cpcbuild.importer",
          "group": "navigation@90"
        },
        {
          "command": "cpcbuild.tmx.generate",
          "when": "cpcbuild.inProject && activeCustomEditorId == cpcbuild.tmxViewer",
          "group": "navigation@10"
        },
        {
          "command": "cpcbuild.openInTiled",
          "when": "cpcbuild.inProject && activeCustomEditorId == cpcbuild.tmxViewer",
          "group": "navigation@20"
        },
        {
          "command": "cpcbuild.openAsText",
          "when": "cpcbuild.inProject && activeCustomEditorId == cpcbuild.tmxViewer",
          "group": "navigation@90"
        },
        {
          "command": "cpcbuild.generateAssetFile",
          "when": "cpcbuild.inProject && (activeCustomEditorId == cpcbuild.spriteEditor || activeCustomEditorId == cpcbuild.tileEditor)",
          "group": "navigation@10"
        },
        {
          "command": "cpcbuild.insertAssetUse",
          "when": "cpcbuild.inProject && (activeCustomEditorId == cpcbuild.spriteEditor || activeCustomEditorId == cpcbuild.tileEditor)",
          "group": "navigation@20"
        },
        {
          "command": "cpcbuild.openAsText",
          "when": "cpcbuild.inProject && (activeCustomEditorId == cpcbuild.spriteEditor || activeCustomEditorId == cpcbuild.tileEditor)",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "cpcbuild.runFile",
          "when": "false"
        },
        {
          "command": "cpcbuild.copyImporterCommand",
          "when": "false"
        },
        {
          "command": "cpcbuild.symbols.copyAddress",
          "when": "false"
        },
        {
          "command": "cpcbuild.symbols.goToDefinition",
          "when": "false"
        },
        {
          "command": "cpcbuild.debug.removeBreakpoint",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "cpcbuild.symbols.filter",
          "when": "view == cpcbuild.symbols",
          "group": "navigation@1"
        },
        {
          "command": "cpcbuild.symbols.toggleRuntime",
          "when": "view == cpcbuild.symbols",
          "group": "navigation@2"
        },
        {
          "command": "cpcbuild.symbols.refresh",
          "when": "view == cpcbuild.symbols",
          "group": "navigation@3"
        },
        {
          "command": "cpcbuild.debug.pause",
          "when": "view == cpcbuild.registers && cpcbuild.debug.live && !cpcbuild.debug.paused",
          "group": "navigation@1"
        },
        {
          "command": "cpcbuild.debug.resume",
          "when": "view == cpcbuild.registers && cpcbuild.debug.paused",
          "group": "navigation@1"
        },
        {
          "command": "cpcbuild.debug.step",
          "when": "view == cpcbuild.registers && cpcbuild.debug.paused",
          "group": "navigation@2"
        },
        {
          "command": "cpcbuild.debug.stepOver",
          "when": "view == cpcbuild.registers && cpcbuild.debug.paused",
          "group": "navigation@3"
        },
        {
          "command": "cpcbuild.debug.stepOut",
          "when": "view == cpcbuild.registers && cpcbuild.debug.paused",
          "group": "navigation@4"
        },
        {
          "command": "cpcbuild.memory.show",
          "when": "view == cpcbuild.registers",
          "group": "navigation@5"
        },
        {
          "command": "cpcbuild.debug.toggleBreakpoint",
          "when": "view == cpcbuild.breakpoints",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "cpcbuild.debug.toggleBreakpoint",
          "when": "view == cpcbuild.symbols && viewItem =~ /^symbol\\.(basic|library|runtime)/",
          "group": "inline@1"
        },
        {
          "command": "cpcbuild.symbols.copyAddress",
          "when": "view == cpcbuild.symbols && viewItem =~ /^symbol\\./",
          "group": "inline@2"
        },
        {
          "command": "cpcbuild.symbols.goToDefinition",
          "when": "view == cpcbuild.symbols && viewItem =~ /^symbol\\..*\\.def$/",
          "group": "navigation@1"
        },
        {
          "command": "cpcbuild.debug.toggleBreakpoint",
          "when": "view == cpcbuild.symbols && viewItem =~ /^symbol\\./",
          "group": "navigation@2"
        },
        {
          "command": "cpcbuild.symbols.copyAddress",
          "when": "view == cpcbuild.symbols && viewItem =~ /^symbol\\./",
          "group": "navigation@3"
        },
        {
          "command": "cpcbuild.debug.removeBreakpoint",
          "when": "view == cpcbuild.breakpoints && viewItem == breakpoint",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "CPCBuild",
      "properties": {
        "cpcbuild.zxbc.command": {
          "type": "array",
          "default": [
            "zxbc"
          ],
          "description": "How to start the compiler. Leave it at the default to use the SDK folder, the tools that \"CPCBuild: Download Tools\" installed, or zxbc on PATH. For the Boriel fork run through poetry: [\"poetry\", \"run\", \"zxbc\"].",
          "items": {
            "type": "string"
          },
          "scope": "resource"
        },
        "cpcbuild.zxbc.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for the compiler (the zxbasic checkout when using poetry). Empty = the project folder.",
          "scope": "resource"
        },
        "cpcbuild.sdk.path": {
          "type": "string",
          "default": "",
          "description": "The CPCBuild SDK folder (the one holding bin/zxbc, lib/ and tools/). Empty = look for one at or above the project, then use the tools that \"CPCBuild: Download Tools\" installed.",
          "scope": "resource"
        },
        "cpcbuild.zxbc.args": {
          "type": "array",
          "default": [],
          "description": "Extra arguments added to every zxbc call.",
          "items": {
            "type": "string"
          },
          "scope": "resource"
        },
        "cpcbuild.python.path": {
          "type": "string",
          "default": "python3",
          "description": "Python 3 for mkdsk.py, mkcpr.py and the Python image engine; only needed with the python engine or a zxbasic checkout. Unset means python3 (py -3 on Windows).",
          "scope": "resource"
        },
        "cpcbuild.library.path": {
          "type": "string",
          "default": "",
          "description": "The cpcbuild checkout: the folder containing lib/ and tools/. Empty = search upwards from the project, then the project's \"library\" field.",
          "scope": "resource"
        },
        "cpcbuild.build.org": {
          "type": "string",
          "default": "",
          "description": "Default --org for CPC targets (0x40, &4000 or decimal). Empty = the compiler's default (&0040). A target's own \"org\" wins.",
          "scope": "resource"
        },
        "cpcbuild.build.outputDir": {
          "type": "string",
          "default": "build",
          "description": "Folder (relative to the project) for .bin, .map, .dsk and .cpr files.",
          "scope": "resource"
        },
        "cpcbuild.build.memoryLimits": {
          "type": "object",
          "default": {},
          "description": "Extra reference lines for the build report: name to address, e.g. {\"my buffer\": \"0x7000\"}.",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          },
          "scope": "resource"
        },
        "cpcbuild.target.default": {
          "type": "string",
          "default": "",
          "description": "Id of the target used by Build and Run when none was chosen with \"CPCBuild: Select Target\" (empty = the first target). Select Target remembers its choice per project in the workspace state, not in this setting.",
          "scope": "resource"
        },
        "cpcbuild.model": {
          "type": "string",
          "default": "6128",
          "description": "Emulated model; when set explicitly it overrides each target's own model.",
          "enum": [
            "464",
            "664",
            "6128",
            "plus"
          ],
          "scope": "resource"
        },
        "cpcbuild.run.emulator": {
          "type": "string",
          "default": "emu",
          "description": "Where Run goes. \"emu\" needs the CPCBuild Emulator extension and falls back to an external emulator with a message.",
          "enum": [
            "emu",
            "caprice32",
            "cpcec",
            "rvm",
            "custom"
          ],
          "scope": "resource"
        },
        "cpcbuild.run.caprice32Path": {
          "type": "string",
          "default": "",
          "description": "Caprice32 executable (empty = tools/caprice32/work/src/cap32 of the library, then the sibling caprice32 checkout).",
          "scope": "resource"
        },
        "cpcbuild.run.cpcecPath": {
          "type": "string",
          "default": "",
          "description": "CPCEC executable (empty = tools/cpcec/work/cpcec of the library).",
          "scope": "resource"
        },
        "cpcbuild.run.rvmPath": {
          "type": "string",
          "default": "",
          "description": "Retro Virtual Machine application (empty = look in /Applications).",
          "scope": "resource"
        },
        "cpcbuild.run.customCommand": {
          "type": "string",
          "default": "",
          "description": "Command for \"custom\": words with ${dsk}, ${cpr}, ${bin}, ${model}. No shell is used.",
          "scope": "resource"
        },
        "cpcbuild.run.zxEmulator": {
          "type": "string",
          "default": "",
          "description": "External Spectrum emulator (for example Fuse or ZEsarUX) that Build and Run starts on the .tap of a zx48k target. Empty = Spectrum targets are build-only.",
          "scope": "resource"
        },
        "cpcbuild.run.zxEmulatorArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "${file}"
          ],
          "description": "Arguments for cpcbuild.run.zxEmulator; ${file} is the .tap path. No shell is used.",
          "scope": "resource"
        },
        "cpcbuild.run.autorunCommand": {
          "type": "string",
          "default": "run\"${name}",
          "description": "Typed after boot for disc runs; ${name} is the AMSDOS name.",
          "scope": "resource"
        },
        "cpcbuild.assets.engine": {
          "type": "string",
          "default": "builtin",
          "description": "Image importer engine.",
          "enum": [
            "builtin",
            "python"
          ]
        },
        "cpcbuild.assets.generateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Write the .bas when a Studio document is saved."
        },
        "cpcbuild.assets.regenerateBeforeBuild": {
          "type": "boolean",
          "default": true,
          "description": "Rebuild stale generated files before a build."
        },
        "cpcbuild.assets.header": {
          "type": "string",
          "default": "img2cpc",
          "description": "Header of generated files.",
          "enum": [
            "img2cpc",
            "studio",
            "none"
          ]
        },
        "cpcbuild.editor.defaultZoom": {
          "type": "number",
          "default": 12,
          "description": "Initial zoom of the pixel editors."
        },
        "cpcbuild.editor.showByteGrid": {
          "type": "boolean",
          "default": true,
          "description": "Draw the byte-boundary grid in the pixel editors."
        },
        "cpcbuild.editor.pixelAspect": {
          "type": "string",
          "default": "square",
          "description": "Pixel shape in the editors.",
          "enum": [
            "square",
            "crt"
          ]
        },
        "cpcbuild.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for library lint."
        },
        "cpcbuild.lint.rules": {
          "type": "object",
          "default": {},
          "description": "Rule id to off, hint, warning or error."
        },
        "cpcbuild.hover.enable": {
          "type": "boolean",
          "default": true,
          "description": "Library hover and signature help."
        },
        "cpcbuild.arkos.toolsPath": {
          "type": "string",
          "default": "",
          "description": "Arkos command-line tools (default $AT3_TOOLS, then tools/arkos/work/bin)."
        },
        "cpcbuild.arkos.trackerPath": {
          "type": "string",
          "default": "",
          "description": "Arkos Tracker application for \"Open in Arkos Tracker\"."
        },
        "cpcbuild.arkos.psg": {
          "type": "string",
          "default": "cpc",
          "description": "PSG clock for effect banks.",
          "enum": [
            "cpc",
            "spectrum"
          ]
        },
        "cpcbuild.tiled.path": {
          "type": "string",
          "default": "",
          "description": "Tiled application for \"Open in Tiled\"."
        },
        "cpcbuild.emu.pollRateHz": {
          "type": "number",
          "default": 2,
          "description": "How often (per second) the live views (symbol values, memory) read the running emulator; at most 2. While the program is paused they refresh once per pause.",
          "maximum": 2,
          "minimum": 0.2
        },
        "cpcbuild.keybindings.enable": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to the build and run key bindings."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "zxbc",
        "owner": "cpcbuild",
        "source": "zxbc",
        "severity": "error",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+): (error|warning): (?:\\[([EW]\\d+)\\] )?(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "cpcbuild",
        "required": [],
        "properties": {
          "target": {
            "type": "string",
            "description": "Target id from cpcbuild.json (default: the selected target)."
          },
          "run": {
            "type": "boolean",
            "description": "Run in the emulator after a successful build.",
            "default": false
          },
          "project": {
            "type": "string",
            "description": "Folder holding cpcbuild.json, absolute or relative to the workspace folder (default: the project of the active editor)."
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "cpcbuild.json",
        "url": "./schemas/cpcbuild.schema.json"
      }
    ],
    "languages": [
      {
        "id": "cpcbuild-sprite",
        "extensions": [
          ".cpcspr"
        ],
        "aliases": [
          "CPCBuild sprite"
        ],
        "icon": {
          "light": "./media/icons/sprite.svg",
          "dark": "./media/icons/sprite.svg"
        }
      },
      {
        "id": "cpcbuild-tileset",
        "extensions": [
          ".cpctil"
        ],
        "aliases": [
          "CPCBuild tile set"
        ],
        "icon": {
          "light": "./media/icons/tile.svg",
          "dark": "./media/icons/tile.svg"
        }
      },
      {
        "id": "cpcbuild-palette",
        "extensions": [
          ".cpcpal"
        ],
        "aliases": [
          "CPCBuild palette"
        ],
        "icon": {
          "light": "./media/icons/palette.svg",
          "dark": "./media/icons/palette.svg"
        }
      },
      {
        "id": "cpcbuild-palette12",
        "extensions": [
          ".cpcpal12"
        ],
        "aliases": [
          "CPCBuild Plus palette"
        ],
        "icon": {
          "light": "./media/icons/palette.svg",
          "dark": "./media/icons/palette.svg"
        }
      },
      {
        "id": "cpcbuild-importer",
        "extensions": [
          ".cpcimp"
        ],
        "aliases": [
          "CPCBuild import recipe"
        ],
        "icon": {
          "light": "./media/icons/importer.svg",
          "dark": "./media/icons/importer.svg"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "cpcbuild-file-icons",
        "label": "CPCBuild File Icons",
        "path": "./media/icon-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cpcbuild",
          "title": "CPCBuild",
          "icon": "$(chip)"
        }
      ]
    },
    "views": {
      "cpcbuild": [
        {
          "id": "cpcbuild.symbols",
          "name": "Symbols",
          "when": "cpcbuild.active",
          "contextualTitle": "CPCBuild Symbols"
        },
        {
          "id": "cpcbuild.registers",
          "name": "Registers",
          "when": "cpcbuild.active",
          "contextualTitle": "CPC Registers"
        },
        {
          "id": "cpcbuild.breakpoints",
          "name": "Breakpoints",
          "when": "cpcbuild.active",
          "contextualTitle": "CPC Breakpoints"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cpcbuild.symbols",
        "when": "cpcbuild.symbols.noMap",
        "contents": "Build the project to list its symbols (labels and addresses from the compiler map).\n[Build](command:cpcbuild.build)"
      },
      {
        "view": "cpcbuild.breakpoints",
        "contents": "No breakpoints. Toggle one on a symbol in the Symbols view, or by name or address.\n[Toggle Breakpoint](command:cpcbuild.debug.toggleBreakpoint)"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "build:test": "tsc -p tsconfig.test.json",
    "test:unit": "vitest run",
    "test:vscode": "npm run build && npm run build:test && node out/test/runTest.js",
    "test": "npm run test:unit && npm run test:vscode",
    "package": "npm run build && vsce package --allow-missing-repository",
    "test:integration": "npm run build && npm run build:test && node out/test/runIntegration.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
