{
  "name": "cpcbuild-emu",
  "displayName": "CPC Game Studio Emulator",
  "icon": "media/icon.png",
  "description": "Amstrad CPC and CPC Plus emulator (CPCEC compiled to WebAssembly) in a VS Code tab.",
  "version": "0.1.0",
  "publisher": "cpcbuild",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:cpcbuild.emu.version",
    "onCommand:cpcbuild.emu.open",
    "onCommand:cpcbuild.emu.reset",
    "onCommand:cpcbuild.emu.pause",
    "onCommand:cpcbuild.emu.resume",
    "onCommand:cpcbuild.emu.step",
    "onCommand:cpcbuild.emu.stepOver",
    "onCommand:cpcbuild.emu.stepOut",
    "onCommand:cpcbuild.emu.state",
    "onCommand:cpcbuild.emu.readMemory",
    "onCommand:cpcbuild.emu.writeMemory",
    "onCommand:cpcbuild.emu.setBreakpoint",
    "onCommand:cpcbuild.emu.clearBreakpoint",
    "onCommand:cpcbuild.emu.screenshot",
    "onCommand:cpcbuild.emu.close",
    "onCommand:cpcbuild.emu.openFile",
    "onCommand:cpcbuild.emu.runFile"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "cpcbuild.emu.openFile",
        "title": "Open File...",
        "category": "CPC Emulator",
        "icon": "$(play)"
      },
      {
        "command": "cpcbuild.emu.runFile",
        "title": "Run in CPC Emulator",
        "category": "CPC Emulator"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cpcbuild.emu.runFile",
          "when": "resourceExtname =~ /^\\.(cpr|sna)$/i || resourceExtname =~ /^\\.dsk$/i && !cpcbuild.inProject",
          "group": "navigation@91"
        }
      ],
      "editor/title/context": [
        {
          "command": "cpcbuild.emu.runFile",
          "when": "resourceExtname =~ /^\\.(cpr|sna)$/i || resourceExtname =~ /^\\.dsk$/i && !cpcbuild.inProject",
          "group": "navigation@91"
        }
      ],
      "commandPalette": [
        {
          "command": "cpcbuild.emu.runFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "CPC Game Studio Emulator",
      "properties": {
        "cpcbuild.emu.runHidden": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Keep the emulator running while its tab is hidden. Off: it pauses silently when the tab is not visible and carries on when it is shown again. Browsers throttle hidden pages, so a hidden emulator may run slower than real time."
        },
        "cpcbuild.emu.defaultModel": {
          "type": "string",
          "enum": [
            "464",
            "664",
            "6128",
            "plus"
          ],
          "default": "6128",
          "markdownDescription": "The CPC model used by **CPC Emulator: Open File...** for `.dsk` and `.sna` files. A `.cpr` cartridge always starts a CPC Plus."
        }
      }
    }
  },
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "build": "node scripts/stage.mjs && node scripts/build.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:vscode": "npm run build && npm run build:test && python3 test/prepare_media.py && node out/test/runTest.js",
    "test": "npm run test:unit && npm run test:vscode",
    "test:wasm": "node test/wasm-smoke.mjs",
    "test:golden": "python3 test/prepare_media.py && node test/golden.mjs",
    "source": "sh scripts/make-source.sh",
    "package": "npm run build && npm run source && vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/carcharo/cpcbuild#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/carcharo/cpcbuild",
    "directory": "vscode/cpcbuild-emu"
  },
  "bugs": {
    "url": "https://github.com/carcharo/cpcbuild/issues"
  },
  "keywords": [
    "amstrad",
    "cpc",
    "z80",
    "boriel",
    "basic",
    "retro"
  ]
}
