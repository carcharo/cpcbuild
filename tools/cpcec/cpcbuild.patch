+// CPCBuild additions to CPCEC (GPLv3, like the rest of this file set): command-line
+// options for unattended test runs. See tools/cpcec/README.md in the cpcbuild repo.
+// Everything here is inert unless one of the long options below is given.
+//
+//   --headless       SDL dummy video+audio, no sound, no real-time delays (every frame
+//                    is still rendered), no configuration file read or written
+//   --printer FILE   record the CPC printer port into FILE from the start
+//   --shot-dir DIR   a line "\004SHOT name\n" on the printer port saves the screen
+//                    as DIR/name.png two frames later
+//   --shot FILE      save the screen as PNG when the run ends (or at --shot-at)
+//   --shot-at N      take the --shot picture at frame N (the run goes on)
+//   --max-frames N   quit after N frames (exit status 3)
+//   --end-on-marker  quit three frames after the printer receives "\004END\n"
+//
+// Included twice by cpcec.c: CB_PART 1 before cpcec-rt.h (variables, option parser),
+// CB_PART 2 before main() (the per-frame hook, which needs the printer and the PNG code).
+
+#if CB_PART == 1
+
+#include <stdlib.h>
+#include <string.h>
+
+char cb_headless=0,cb_noconfig=0,cb_endmarker=0,cb_quit=0,cb_status=0;
+const char *cb_printer_path=NULL,*cb_shot_dir=NULL,*cb_shot_file=NULL;
+const char *cb_shotpath=NULL; // consulted by session_savebitmap()
+long cb_max_frames=0,cb_shot_at=0; // 0 = off
+long cb_frame_no=0,cb_end_at=-1;
+
+#define CB_SHOTS 16
+struct { long due; char name[64]; } cb_shots[CB_SHOTS]; int cb_shot_n=0;
+char cb_line[96]; int cb_line_n=0;
+
+void cb_args(int *argc,char **argv) // strip and act on the "--long" options; everything else is left alone
+{
+	int i=1,o=1; for (;i<*argc;++i)
+	{
+		const char *a=argv[i]; int v=i+1<*argc;
+		if (!strcmp(a,"--headless")) cb_headless=cb_noconfig=1;
+		else if (!strcmp(a,"--no-config")) cb_noconfig=1;
+		else if (!strcmp(a,"--end-on-marker")) cb_endmarker=1;
+		else if (v&&!strcmp(a,"--printer")) cb_printer_path=argv[++i];
+		else if (v&&!strcmp(a,"--shot-dir")) cb_shot_dir=argv[++i];
+		else if (v&&!strcmp(a,"--shot")) cb_shot_file=argv[++i];
+		else if (v&&!strcmp(a,"--shot-at")) cb_shot_at=atol(argv[++i]);
+		else if (v&&!strcmp(a,"--max-frames")) cb_max_frames=atol(argv[++i]);
+		else argv[o++]=argv[i];
+	}
+	*argc=o;
+	if (cb_headless) // SDL reads these in SDL_Init(); keep the caller's choice if there is one
+	{
+		#ifndef _WIN32
+		setenv("SDL_VIDEODRIVER","dummy",0); setenv("SDL_AUDIODRIVER","dummy",0);
+		#endif
+	}
+}
+
+#else // CB_PART 2
+
+void cb_shot_save(const char *path)
+{
+	char f=session_scrn_flag; session_scrn_flag=1; // PNG (PNG_OUTPUT_MODE 0 is set above)
+	cb_shotpath=path; if (session_savebitmap()) fprintf(stderr,"cpcec: cannot save %s\n",path);
+	cb_shotpath=NULL; session_scrn_flag=f;
+}
+
+void cb_printer(int c) // called with every byte the program sends to the printer port
+{
+	if (c=='\n')
+	{
+		cb_line[cb_line_n]=0;
+		if (cb_shot_dir&&!strncmp(cb_line,"\004SHOT ",6)&&cb_line[6]&&cb_shot_n<CB_SHOTS)
+		{
+			cb_shots[cb_shot_n].due=cb_frame_no+2; // a couple of frames later
+			int k=0; for (const char *s=cb_line+6;*s&&k<60;++s) // names stay plain file names
+				cb_shots[cb_shot_n].name[k++]=(*s>='0'&&*s<='9')||(*s>='A'&&*s<='Z')||(*s>='a'&&*s<='z')||*s=='_'||*s=='-'||*s=='.'?*s:'_';
+			cb_shots[cb_shot_n++].name[k]=0;
+		}
+		else if (cb_endmarker&&!strcmp(cb_line,"\004END")&&cb_end_at<0)
+			cb_end_at=cb_frame_no+3;
+		cb_line_n=0;
+	}
+	else
+	{
+		if (c==4) cb_line_n=0; // EOT starts a marker: whatever was printed before it (PRINT AT has no newline) is not part of it
+		if (cb_line_n<(int)sizeof(cb_line)-1) cb_line[cb_line_n++]=c;
+	}
+}
+
+void cb_frame(void) // end of every emulated frame, before the picture is shown
+{
+	++cb_frame_no;
+	if (printer) printer_flush(); // so a watcher of the file sees the program's output at once
+	for (int i=0;i<cb_shot_n;)
+		if (cb_shots[i].due<=cb_frame_no)
+		{
+			char p[512]; snprintf(p,sizeof(p),"%s/%s.png",cb_shot_dir,cb_shots[i].name);
+			cb_shot_save(p); memmove(&cb_shots[i],&cb_shots[i+1],sizeof(cb_shots[0])*(--cb_shot_n-i));
+		}
+		else ++i;
+	if (cb_shot_file&&cb_shot_at&&cb_frame_no==cb_shot_at) cb_shot_save(cb_shot_file),cb_shot_file=NULL;
+	if (cb_end_at>=0&&cb_frame_no>=cb_end_at&&!cb_shot_n) cb_quit=1;
+	else if (cb_max_frames&&cb_frame_no>=cb_max_frames) cb_quit=1,cb_status=3;
+}
+
+void cb_exit(void) // after the main loop: the --shot picture of the final frame
+{
+	if (cb_shot_file) cb_shot_save(cb_shot_file),cb_shot_file=NULL;
+}
+
+#endif
